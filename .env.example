# Copy this file's contents into your Vercel project's Environment Variables
# (Project -> Settings -> Environment Variables), or into a local .env file
# for `vercel dev`. Never commit real values — this file is just a template.

# --- Email (Resend) ---------------------------------------------------------
# Required for booking confirmation/receipt emails and admin notifications.
# Get a free key at https://resend.com after signing up (Settings -> API Keys).
RESEND_API_KEY=

# Optional. The "from" address emails are sent as. Until you verify your own
# domain in Resend, leave this unset — it falls back to Resend's shared test
# sender, which works immediately with no setup.
# FROM_EMAIL=D.M Barber Shop <bookings@yourdomain.com>

# Optional. Where new-booking notifications are sent. Defaults to the shop
# email address in lib/data.js (hello@dmbarbershop.co.za) if left unset.
# ADMIN_EMAIL=owner@yourdomain.com

# --- Staff admin page (/admin.html) -----------------------------------------
# Required to view bookings at /admin.html. Choose any private password —
# this is the only thing gating that page, so keep it secret.
ADMIN_KEY=

# --- Database (Redis) --------------------------------------------------------
# Not set by hand: in Vercel, go to the project's Storage tab, add a Redis
# database (Upstash), and connect it to this project. Vercel then injects
# these automatically. Only fill these in for local testing against a real
# database outside of Vercel.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
